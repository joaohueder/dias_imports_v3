# ==============================================================================
# AMBIENTE & APLICACAO
# ==============================================================================
# Define se o sistema roda em modo desenvolvimento (development) ou producao (production)
NODE_ENV=production

# Porta interna onde a aplicacao vai rodar
PORT=3000

# Nome publico do sistema exibido nas telas e no navegador
NEXT_PUBLIC_APP_NAME="JH7 Marketing"

# Endereco web base da aplicacao (local ou seu dominio de producao)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# BANCO DE DADOS (MySQL / Prisma)
# ==============================================================================
# Endereco do servidor MySQL (ex: localhost, 127.0.0.1 ou IP da VPS)
DB_HOST="207.58.153.188"

# Porta padrao de conexao com o MySQL (normalmente 3306)
DB_PORT="3306"

# Usuario com permissao no banco de dados MySQL
